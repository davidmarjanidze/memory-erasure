{
  "name": "memory-erasure",
  "version": "2.1.0",
  "description": "Overwrites the free space of a disk with random data so deleted files can't be recovered.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.15"
  },
  "scripts": {
    "build": "node build.js",
    "lint": "eslint . && tsc",
    "format": "prettier --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "npm-publish": "npm run lint && npm test && npm run build && npm publish"
  },
  "author": "David Marjanidze",
  "license": "ISC",
  "homepage": "https://github.com/davidmarjanidze/memory-erasure#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmarjanidze/memory-erasure.git"
  },
  "bugs": {
    "url": "https://github.com/davidmarjanidze/memory-erasure/issues"
  },
  "keywords": [
    "erase",
    "wipe",
    "free space",
    "disk",
    "deleted files",
    "secure delete"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
